// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

// Users
model User {
  id                String    @id @default(uuid())
  email             String    @unique
  googleId          String?   @unique @map("google_id")
  name              String
  avatarUrl         String?   @map("avatar_url")
  phoneWhatsapp     String?   @map("phone_whatsapp")
  currency          String    @default("ILS")
  language          String    @default("he")
  theme             String    @default("system")
  householdId       String?   @map("household_id")
  monthlyDigest     Boolean   @default(true) @map("monthly_digest")
  budgetAlerts      Boolean   @default(true) @map("budget_alerts")
  createdAt         DateTime  @default(now()) @map("created_at")
  lastLogin         DateTime? @map("last_login")

  // Relations
  accounts          Account[]
  transactions      Transaction[]
  budgets           Budget[]
  goals             Goal[]
  imports           Import[]
  merchantRules     MerchantRule[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  categories        Category[]
  household         Household? @relation("HouseholdUsers", fields: [householdId], references: [id])

  @@map("users")
}

// Households (family sharing)
model Household {
  id        String   @id @default(uuid())
  name      String
  ownerId   String   @map("owner_id")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  users User[] @relation("HouseholdUsers")

  @@map("households")
}

// Accounts (credit cards / bank accounts)
model Account {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String
  type      String   // 'credit_card' | 'bank' | 'cash' | 'digital'
  provider  String?  // 'amex' | 'isracard' | 'hapoalim' etc.
  lastFour  String?  @map("last_four")
  color     String   @default("#2E6FBF")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("accounts")
}

// Categories
model Category {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id") // NULL = system default
  name        String
  icon        String
  color       String?
  type        String   // 'expense' | 'income'
  parentId    String?  @map("parent_id")
  isDefault   Boolean  @default(false) @map("is_default")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  user       User?       @relation(fields: [userId], references: [id])
  parent     Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children   Category[]  @relation("CategoryHierarchy")
  budgets    Budget[]
  transactions Transaction[]
  merchantRules MerchantRule[]

  @@map("categories")
}

// Transactions
model Transaction {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  accountId         String?   @map("account_id")
  date              DateTime
  merchant          String
  originalMerchant  String?   @map("original_merchant")
  amount            Decimal   @db.Decimal(12, 2)
  currency          String    @default("ILS")
  amountIls         Decimal?  @db.Decimal(12, 2) @map("amount_ils")
  categoryId        String?   @map("category_id")
  subcategory       String?
  note              String?
  tags              Json      @default("[]")
  isRecurring       Boolean   @default(false) @map("is_recurring")
  recurringInterval String?   @map("recurring_interval")
  isHidden          Boolean   @default(false) @map("is_hidden")
  isSplit           Boolean   @default(false) @map("is_split")
  sourceFileId      String?   @map("source_file_id")
  aiConfidence      Int?      @map("ai_confidence")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  // Relations
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account    Account?  @relation(fields: [accountId], references: [id])
  category   Category? @relation(fields: [categoryId], references: [id])
  sourceFile Import?   @relation(fields: [sourceFileId], references: [id])

  @@map("transactions")
}

// Budgets / Goals
model Budget {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  categoryId   String?   @map("category_id")
  name         String
  type         String
  targetAmount Decimal   @db.Decimal(12, 2) @map("target_amount")
  period       String    @default("monthly")
  startDate    DateTime? @map("start_date") @db.Date
  rollover     Boolean   @default(false)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category? @relation(fields: [categoryId], references: [id])

  @@map("budgets")
}

// Savings Goals
model Goal {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  name          String
  targetAmount  Decimal   @db.Decimal(12, 2) @map("target_amount")
  currentAmount Decimal   @db.Decimal(12, 2) @default(0) @map("current_amount")
  deadline      DateTime? @db.Date
  type          String
  icon          String?
  isAchieved    Boolean   @default(false) @map("is_achieved")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("goals")
}

// Import History
model Import {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  filename      String
  provider      String?
  status        String    @default("pending") // 'pending' | 'processing' | 'done' | 'error'
  rowsTotal     Int?      @map("rows_total")
  rowsSuccess   Int?      @map("rows_success")
  rowsDuplicate Int?      @map("rows_duplicate")
  rowsError     Int?      @map("rows_error")
  r2Key         String?   @map("r2_key")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("imports")
}

// Merchant Rules (personal learning)
model MerchantRule {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id") // NULL = global rule
  pattern    String
  categoryId String   @map("category_id")
  isRegex    Boolean  @default(false) @map("is_regex")
  usageCount Int      @default(0) @map("usage_count")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user     User?      @relation(fields: [userId], references: [id])
  category Category  @relation(fields: [categoryId], references: [id])

  @@unique([userId, pattern])
  @@map("merchant_rules")
}

// Notifications
model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  title     String?
  message   String
  channel   String    @default("app") // 'app' | 'whatsapp' | 'email'
  isRead    Boolean   @default(false) @map("is_read")
  sentAt    DateTime  @default(now()) @map("sent_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// Audit Log
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@map("audit_log")
}
