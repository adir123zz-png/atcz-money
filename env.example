# App
ENVIRONMENT=production
NEXT_PUBLIC_APP_URL=https://app.atcz-money.com
NODE_VERSION=20

# Authentication (NextAuth.js)
NEXTAUTH_URL=https://app.atcz-money.com
NEXTAUTH_SECRET=<generate: openssl rand -base64 32>
GOOGLE_CLIENT_ID=<from Google Cloud Console>
GOOGLE_CLIENT_SECRET=<from Google Cloud Console>

# Database (Supabase)
DATABASE_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
SUPABASE_URL=https://[project].supabase.co
SUPABASE_ANON_KEY=<from Supabase Dashboard>
SUPABASE_SERVICE_ROLE_KEY=<from Supabase Dashboard>

# AI (OpenAI)
OPENAI_API_KEY=sk-...

# WhatsApp (Twilio)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=<from Twilio Console>
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Cloudflare R2 Storage
CLOUDFLARE_ACCOUNT_ID=<from Cloudflare Dashboard>
R2_ACCESS_KEY_ID=<R2 API token key ID>
R2_SECRET_ACCESS_KEY=<R2 API token secret>
R2_BUCKET_NAME=atcz-money-imports
R2_PUBLIC_URL=https://r2.atcz-money.com

# Cloudflare KV
CLOUDFLARE_KV_NAMESPACE_ID=<from Workers KV>
CLOUDFLARE_API_TOKEN=<with KV read/write permissions>

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=<from Turnstile Dashboard>
TURNSTILE_SECRET_KEY=<from Turnstile Dashboard>

# Security
ENCRYPTION_KEY=<generate: openssl rand -base64 32>
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=15m

# Exchange Rates
BOI_API_URL=https://edge.boi.org.il/FusionEdgeServer/sdmx/v2/data/dataflow/BOI.STATISTICS/EXR/1.0/RER_USD_ILS
